# SmartKitchen production environment reference — PLACEHOLDERS ONLY, never put real values in git.
# On Render these are set by deploy/render.yaml (value / generateValue / fromService / fromDatabase) or by hand
# in the dashboard for keys marked sync: false. Named without a leading dot on purpose: .gitignore ignores .env.*.
#
# Generate random secrets (64 hex chars):
#   openssl rand -hex 32
#   PowerShell: -join (1..64 | % { [char]((48..57)+(97..102) | Get-Random) })

# ---------------- shared ----------------
NODE_ENV=production
# Same value for auth-service and gateway (and family-service later). >= 32 chars (auth/family refuse less).
JWT_SECRET=<generated: 64 hex chars>
# Same value for admin-service and notification-service.
INTERNAL_API_KEY=<generated: 64 hex chars>

# ---------------- gateway (the ONLY public service) ----------------
PORT=4000
# Real mobile/web origins, comma-separated. Never * in production.
CORS_ORIGINS=https://app.example.vn,https://admin.example.vn
# Render/most PaaS put exactly one proxy in front of the app: trust one hop so rate limits use the client IP.
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
CACHE_TTL_SECONDS=30
CACHE_MAX_ITEMS=500
# Private-network addresses of backends; a bare host:port is accepted (http:// is added).
AUTH_SERVICE_URL=smartkitchen-auth:4001
NOTIFICATION_SERVICE_URL=smartkitchen-notification:4010
ADMIN_SERVICE_URL=smartkitchen-admin:4011

# ---------------- auth-service (private) ----------------
DATABASE_URL=<from managed PostgreSQL: auth_db>
CORS_ORIGIN=https://app.example.vn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<mailbox>
SMTP_PASS=<app password>
EMAIL_FROM=SmartKitchen <no-reply@example.vn>

# ---------------- notification-service (private) ----------------
# DATABASE_URL=<from managed PostgreSQL: notification_db>
PARTNER_API_KEY=<generated: 64 hex chars, shared only with partners>
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=<from expo.dev account settings>
# true on EXACTLY ONE instance (promotion cron); false everywhere else.
ENABLE_JOBS=true
PROMOTION_CRON=*/15 * * * *
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ---------------- admin-service (private) ----------------
# DATABASE_URL=<from managed PostgreSQL: admin_db>
# true on EXACTLY ONE instance (health poller + retention).
# ENABLE_JOBS=true
HEALTH_POLL_INTERVAL_SECONDS=120
HEALTH_CHECK_TIMEOUT_MS=2000
HEALTH_DEGRADED_THRESHOLD_MS=1000
HEALTH_LOG_RETENTION_DAYS=14
REPORT_RATE_LIMIT_PER_HOUR=5
NOTIFY_TIMEOUT_MS=2000
GATEWAY_URL=smartkitchen-gateway:10000

# Logging: services log one JSON line per error to stdout/stderr (no stack traces, no secrets); the platform
# collects stdout. There is no LOG_LEVEL variable in the code today.
