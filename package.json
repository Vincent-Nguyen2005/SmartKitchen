{
  "name": "smartkitchen",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev --concurrency=20",
    "dev:mobile": "powershell -ExecutionPolicy Bypass -File ./dev-mobile.ps1",
    "build": "turbo build --concurrency=1",
    "lint": "turbo lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check:infra": "node scripts/check-infra.mjs",
    "test:health": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-health.ps1",
    "test:routing": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-routing.ps1",
    "test:e2e-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-e2e-smoke.ps1",
    "test:e2e-smoke:bash": "bash ./scripts/test-e2e-smoke.sh",
    "test:prod-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-prod-smoke.ps1",
    "test:prod-smoke:bash": "bash ./scripts/test-prod-smoke.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
