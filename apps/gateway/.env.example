PORT=4000
DATABASE_URL=
CORS_ORIGINS=*
AUTH_SERVICE_URL=http://localhost:4001
FAMILY_SERVICE_URL=http://localhost:4002
INVENTORY_SERVICE_URL=http://localhost:4003
NUTRITION_SERVICE_URL=http://localhost:4004
MEAL_DIARY_SERVICE_URL=http://localhost:4005
RECIPE_SERVICE_URL=http://localhost:4006
MENU_SERVICE_URL=http://localhost:4007
SHOPPING_LIST_SERVICE_URL=http://localhost:4008
PAYMENT_SERVICE_URL=http://localhost:4009
NOTIFICATION_SERVICE_URL=http://localhost:4010
ADMIN_SERVICE_URL=http://localhost:4011
RATE_LIMIT_WINDOW_MS=60000
# Anonymous requests per IP per window; signed-in requests count per user (USER_RATE_LIMIT_MAX).
RATE_LIMIT_MAX=100
USER_RATE_LIMIT_MAX=600
# Credential calls (non-GET /api/auth) per IP per window.
AUTH_RATE_LIMIT_MAX=20
CACHE_TTL_SECONDS=30
CACHE_MAX_ITEMS=100
TRUST_PROXY=false
# Must equal auth-service JWT_SECRET (HS256). Generate: openssl rand -hex 64
JWT_SECRET="replace-with-the-auth-service-jwt-secret"
