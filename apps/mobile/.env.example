# Auth, family, and other API requests all go through the gateway on port 4000.
# The shared ngrok domain works on physical phones when the gateway and tunnel are running.
# Copy this file to .env.local, or run `pnpm dev:mobile` from the repository root.
# Override with `./dev-mobile.ps1 -GatewayUrl http://192.168.1.10:4000` for a local gateway.
EXPO_PUBLIC_API_BASE_URL=https://jolliness-jackal-twilight.ngrok-free.dev
