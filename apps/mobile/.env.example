# Auth and family requests go through the gateway, not directly to ports 4001/4002.
# Local Expo web (port 8081) uses the browser hostname on port 4000 by default.
# Android emulator defaults to http://10.0.2.2:4000; iOS simulator defaults to http://localhost:4000.
# For a shared backend, all team members set the SAME gateway URL in their own .env.local:
# EXPO_PUBLIC_API_BASE_URL=https://your-shared-gateway.example.com
# This single value is used by both web and native API calls. It contains no secret.
# For a physical device on the same LAN instead, use the server's reachable LAN IP:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
# Legacy web-only override when EXPO_PUBLIC_API_BASE_URL is unset:
# EXPO_PUBLIC_WEB_API_BASE_URL=https://your-gateway.example.com
