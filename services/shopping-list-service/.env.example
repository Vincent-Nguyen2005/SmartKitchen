PORT=4008
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopping_list_db?schema=public"
JWT_SECRET="replace-with-the-root-JWT_SECRET"
FAMILY_SERVICE_URL="http://localhost:4002"
INVENTORY_API_URL="http://localhost:4003"
MENU_SERVICE_URL="http://localhost:4007"
PURCHASE_SYNC_API_KEY="replace-with-a-long-random-purchase-sync-key"
# Service-to-service key (admin-service / inventory / auth / notification internal calls). Generate: openssl rand -hex 32
INTERNAL_API_KEY=
# Catalog prices, groups and shelf life (checkout)
ADMIN_SERVICE_URL=http://localhost:4011
# Shipper account checks and the shipper name / phone shown on orders
AUTH_SERVICE_URL=http://localhost:4001
# Order notices in Thông báo ("Đơn hàng đang được giao" ...)
NOTIFICATION_SERVICE_URL=http://localhost:4010
