generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client-shopping-list"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShoppingList {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @db.Uuid
  activeFamilyId String?  @unique @db.Uuid
  name           String
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ShoppingItem[]
}

model ShoppingItem {
  id                 String    @id @default(uuid()) @db.Uuid
  shoppingListId     String    @db.Uuid
  name               String
  quantity           Float     @default(1)
  unit               String    @default("PIECE")
  isPurchased        Boolean   @default(false)
  inventoryAppliedAt DateTime?
  inventoryItemId    String?   @db.Uuid
  generatedKey       String?
  sourceMenuId       String?   @db.Uuid
  note               String?
  /// Price snapshot taken when the item was added from the market (all optional; older rows have none).
  /// unitPrice: whole VND before discount; discountPercent: 1-100 at add time; productId: admin catalog id.
  unitPrice          Int?
  discountPercent    Int?
  productId          String?
  imageUrl           String?
  /// Set when the line is bought ("Chi tiêu"): the purchase (one "Mua"), the unit price paid after the discount,
  /// the line total round(paidUnitPrice × quantity) in whole VND (null without a price), the catalog group and the
  /// piece word ("quả") at purchase time.
  purchaseId         String?   @db.Uuid
  paidUnitPrice      Int?
  lineTotal          Int?
  groupName          String?
  unitLabel          String?
  /// Catalog shelf-life days at order time: expiry in Kho = delivery day (Vietnam) + these days.
  shelfLifeDays      Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  purchase     Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@unique([shoppingListId, generatedKey])
  @@index([shoppingListId])
  @@index([purchaseId])
}

/// Delivery order status. PENDING (đã đặt) → SHIPPING (đang giao, a shipper accepted) → DELIVERED (đã giao);
/// PENDING → CANCELLED (the family cancelled); SHIPPING → FAILED (the shipper could not deliver).
enum OrderStatus {
  PENDING
  SHIPPING
  DELIVERED
  CANCELLED
  FAILED
}

/// An Đi chợ order ("Đặt hàng"), paid cash on delivery (COD): buyer, delivery details, lines (the ordered cart lines,
/// with price snapshots), total = sum of the rounded line totals = COD amount. Only DELIVERED orders count in
/// "Chi tiêu" (by deliveredAt). Purchases made before orders existed are DELIVERED (migration). purchasedAt = when
/// ordered. buyerUserId is always set for new orders.
model Purchase {
  id              String         @id @default(uuid()) @db.Uuid
  familyId        String         @db.Uuid
  buyerUserId     String?        @db.Uuid
  purchasedAt     DateTime       @default(now())
  total           Int            @default(0)
  itemCount       Int            @default(0)
  status          OrderStatus    @default(PENDING)
  /// Only "COD" (thanh toán khi nhận hàng) for now.
  paymentMethod   String         @default("COD")
  codAmount       Int            @default(0)
  deliveryAddress String?
  latitude        Float?
  longitude       Float?
  receiverName    String?
  receiverPhone   String?
  note            String?
  /// The SHIPPER account that accepted the order.
  shipperId       String?        @db.Uuid
  shippingAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  failedAt        DateTime?
  failReason      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  items           ShoppingItem[]

  @@index([familyId, purchasedAt])
  @@index([familyId, deliveredAt])
  @@index([status, purchasedAt])
  @@index([shipperId])
}

model PurchaseHistory {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @db.Uuid
  itemKey        String
  name           String
  unit           String
  quantity       Float
  purchasedAt    DateTime @default(now())
  shoppingItemId String?  @unique @db.Uuid
  createdAt      DateTime @default(now())

  @@index([familyId, itemKey, purchasedAt])
}
