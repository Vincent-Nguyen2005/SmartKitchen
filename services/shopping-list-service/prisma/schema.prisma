generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client-shopping-list"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShoppingList {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @db.Uuid
  activeFamilyId String?  @unique @db.Uuid
  name           String
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ShoppingItem[]
}

model ShoppingItem {
  id                 String    @id @default(uuid()) @db.Uuid
  shoppingListId     String    @db.Uuid
  name               String
  quantity           Float     @default(1)
  unit               String    @default("PIECE")
  isPurchased        Boolean   @default(false)
  inventoryAppliedAt DateTime?
  inventoryItemId    String?   @db.Uuid
  generatedKey       String?
  sourceMenuId       String?   @db.Uuid
  note               String?
  /// Price snapshot taken when the item was added from the market (all optional; older rows have none).
  /// unitPrice: whole VND before discount; discountPercent: 1-100 at add time; productId: admin catalog id.
  unitPrice          Int?
  discountPercent    Int?
  productId          String?
  imageUrl           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@unique([shoppingListId, generatedKey])
  @@index([shoppingListId])
}

model PurchaseHistory {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @db.Uuid
  itemKey        String
  name           String
  unit           String
  quantity       Float
  purchasedAt    DateTime @default(now())
  shoppingItemId String?  @unique @db.Uuid
  createdAt      DateTime @default(now())

  @@index([familyId, itemKey, purchasedAt])
}
