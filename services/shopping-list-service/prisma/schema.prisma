generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client-shopping-list"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShoppingList {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @db.Uuid
  activeFamilyId String?  @unique @db.Uuid
  name           String
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ShoppingItem[]
}

model ShoppingItem {
  id                 String    @id @default(uuid()) @db.Uuid
  shoppingListId     String    @db.Uuid
  name               String
  quantity           Float     @default(1)
  unit               String    @default("PIECE")
  isPurchased        Boolean   @default(false)
  inventoryAppliedAt DateTime?
  inventoryItemId    String?   @db.Uuid
  generatedKey       String?
  sourceMenuId       String?   @db.Uuid
  note               String?
  /// Price snapshot taken when the item was added from the market (all optional; older rows have none).
  /// unitPrice: whole VND before discount; discountPercent: 1-100 at add time; productId: admin catalog id.
  unitPrice          Int?
  discountPercent    Int?
  productId          String?
  imageUrl           String?
  /// Set when the line is bought ("Chi tiêu"): the purchase (one "Mua"), the unit price paid after the discount,
  /// the line total round(paidUnitPrice × quantity) in whole VND (null without a price), the catalog group and the
  /// piece word ("quả") at purchase time.
  purchaseId         String?   @db.Uuid
  paidUnitPrice      Int?
  lineTotal          Int?
  groupName          String?
  unitLabel          String?
  /// Catalog shelf-life days at order time: expiry in Kho = delivery day (Vietnam) + these days.
  shelfLifeDays      Int?
  /// This line's part of the order's checkout promotion (whole VND, largest-remainder split over the eligible lines,
  /// so the parts add up to Purchase.discountAmount); 0 without a promotion. "Chi tiêu" groups count lineTotal − this.
  discountShare      Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  purchase     Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@unique([shoppingListId, generatedKey])
  @@index([shoppingListId])
  @@index([purchaseId])
}

/// Delivery order status. PENDING (đã đặt) → SHIPPING (đang giao, a shipper accepted) → DELIVERED (đã giao);
/// PENDING → CANCELLED (the family cancelled); SHIPPING → FAILED (the shipper could not deliver).
enum OrderStatus {
  PENDING
  SHIPPING
  DELIVERED
  CANCELLED
  FAILED
}

/// An Đi chợ order ("Đặt hàng"), paid cash on delivery (COD): buyer, delivery details, lines (the ordered cart lines,
/// with price snapshots), total = sum of the rounded line totals = COD amount. Only DELIVERED orders count in
/// "Chi tiêu" (by deliveredAt). Purchases made before orders existed are DELIVERED (migration). purchasedAt = when
/// ordered. buyerUserId is always set for new orders.
model Purchase {
  id              String         @id @default(uuid()) @db.Uuid
  familyId        String         @db.Uuid
  buyerUserId     String?        @db.Uuid
  purchasedAt     DateTime       @default(now())
  /// What the family pays: subtotal − discountAmount (= codAmount for delivery orders).
  total           Int            @default(0)
  /// Sum of the rounded line totals (after per-product discounts), before the checkout promotion.
  subtotal        Int            @default(0)
  /// The automatic checkout promotion applied (at most one), with its name as shown at order time.
  promotionId     String?        @db.Uuid
  promotionName   String?
  discountAmount  Int            @default(0)
  itemCount       Int            @default(0)
  status          OrderStatus    @default(PENDING)
  /// Only "COD" (thanh toán khi nhận hàng) for now.
  paymentMethod   String         @default("COD")
  codAmount       Int            @default(0)
  deliveryAddress String?
  latitude        Float?
  longitude       Float?
  receiverName    String?
  receiverPhone   String?
  note            String?
  /// The SHIPPER account that accepted the order.
  shipperId       String?        @db.Uuid
  shippingAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  failedAt        DateTime?
  failReason      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  items           ShoppingItem[]

  @@index([familyId, purchasedAt])
  @@index([familyId, deliveredAt])
  @@index([status, purchasedAt])
  @@index([shipperId])
  @@index([promotionId, buyerUserId])
}

enum PromotionScope {
  ORDER
  GROUP
  PRODUCTS
}

enum PromotionType {
  PERCENT
  AMOUNT
}

/// Quản trị › "Chương trình khuyến mãi": applied automatically at checkout (no code), at most one per order (the one
/// with the largest discount). Days are Vietnam calendar days: running from startDate 00:00 through endDate 23:59:59
/// (Asia/Ho_Chi_Minh). Owned here because checkout prices orders here (one transaction, no sync).
model CheckoutPromotion {
  id                 String         @id @default(uuid()) @db.Uuid
  /// Shown to users ("Khuyến mãi: <name>").
  name               String
  scope              PromotionScope
  /// GROUP: catalog group names (case-insensitive match); PRODUCTS: catalog product ids.
  groups             String[]
  productIds         String[]
  type               PromotionType
  /// PERCENT: 1-100; AMOUNT: whole VND.
  value              Int
  /// PERCENT only: the most it can take off (whole VND); null = no cap.
  maxDiscount        Int?
  /// Order subtotal needed (whole VND); null = none.
  minSubtotal        Int?
  startDate          DateTime       @db.Date
  endDate            DateTime       @db.Date
  /// Times one user may get it (delivered orders, plus orders still on the way); null = unlimited.
  usageLimitPerUser  Int?
  isActive           Boolean        @default(true)
  createdBy          String         @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([isActive, startDate, endDate])
}

/// Admin changes to checkout promotions (who, what, before / after).
model PromotionAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @db.Uuid
  action      String
  promotionId String   @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([promotionId, createdAt])
}

model PurchaseHistory {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @db.Uuid
  itemKey        String
  name           String
  unit           String
  quantity       Float
  purchasedAt    DateTime @default(now())
  shoppingItemId String?  @unique @db.Uuid
  createdAt      DateTime @default(now())

  @@index([familyId, itemKey, purchasedAt])
}

/// Admin actions on delivery orders (Quản trị › Đơn hàng): who, which order, what (CANCEL / UNASSIGN_SHIPPER), before / after.
model OrderAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @db.Uuid
  action      String
  orderId     String   @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}
