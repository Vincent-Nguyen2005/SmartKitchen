generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client-inventory"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Unit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
  PACK
  BOTTLE
  CAN
  BOX
}

enum StorageLocation {
  FRIDGE
  FREEZER
  PANTRY
  COUNTER
}

/// Where a Kho row came from: PURCHASE = bought in Đi chợ (read-only name / unit / quantity / expiry; quantity
/// changes only through cooking and purchase / Cộng thêm merges); MANUAL = added in Kho (photo, typed, voice, receipt).
enum ItemOrigin {
  MANUAL
  PURCHASE
}

enum ItemStatus {
  FRESH
  NEAR_EXPIRY
  EXPIRED
  CONSUMED
  DISCARDED
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  icon      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     FoodItem[]
}

model FoodItem {
  id              String          @id @default(uuid()) @db.Uuid
  familyId        String          @db.Uuid
  name            String
  description     String?
  quantity        Float           @default(0)
  unit            Unit            @default(PIECE)
  minQuantity     Float?
  categoryId      String?         @db.Uuid
  storageLocation StorageLocation @default(FRIDGE)
  expiryDate      DateTime?
  status          ItemStatus      @default(FRESH)
  imageUrl        String?
  /// Admin catalog product id when the item came from the market (Giỏ hàng); the app shows that product's image
  /// when the item has no photo of its own. Never copied into imageUrl.
  productId       String?         @db.VarChar(64)
  barcode         String?         @db.VarChar(32)
  origin          ItemOrigin      @default(MANUAL)
  /// Day of the latest Đi chợ purchase in this row (origin PURCHASE); null for manual rows.
  purchasedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  category Category?      @relation(fields: [categoryId], references: [id])
  logs     InventoryLog[]

  @@index([familyId])
  @@index([expiryDate])
  @@index([status])
}

model InventoryLog {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @db.Uuid
  action      String
  oldValue    Json?
  newValue    Json?
  note        String?
  createdBy   String?  @db.Uuid
  externalRef String?  @unique @db.Uuid
  createdAt   DateTime @default(now())

  item FoodItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

/// One "Đã ăn / nấu xong" deduction from Kho (POST /cook); the client's cookId makes a retried request a no-op.
model CookApplication {
  cookId    String   @id @db.Uuid
  familyId  String   @db.Uuid
  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
}

model PurchaseApplication {
  externalPurchaseId String   @id @db.Uuid
  familyId           String   @db.Uuid
  itemId             String   @db.Uuid
  createdAt          DateTime @default(now())

  @@index([familyId, createdAt])
}
