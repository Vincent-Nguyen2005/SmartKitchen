PORT=4003
DATABASE_URL="postgresql://postgres:postgres@inventory-db:5432/inventory_db?schema=public"
JWT_SECRET="replace-with-the-root-JWT_SECRET"
FAMILY_SERVICE_URL="http://localhost:4002"
PURCHASE_SYNC_API_KEY="replace-with-a-long-random-purchase-sync-key"
OPENFOODFACTS_USER_AGENT="SmartKitchen/1.0 (contact@example.com)"
TESSERACT_LANGUAGES="vie+eng"
# Optional: point to a locally hosted directory containing Tesseract traineddata.
# If omitted, Tesseract.js downloads language data on first OCR request.
# TESSERACT_LANG_PATH="https://tessdata.projectnaptha.com/4.0.0"
# Kho: days an expired item stays listed (dimmed, never used) after its expiry day, then it is hidden.
# Whole number 0-7; 0 (default) = hidden from the day after expiry. Invalid values fall back to 0. Not a secret.
KHO_EXPIRED_GRACE_DAYS=0
