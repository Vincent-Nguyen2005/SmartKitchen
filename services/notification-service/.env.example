PORT=4010
DATABASE_URL="postgresql://postgres:postgres@localhost:5410/notification_db?schema=public"
# Partner ingestion key (x-api-key on /partners*). Generate: openssl rand -hex 32
PARTNER_API_KEY="replace-with-partner-key"
# Service-to-service key for POST /internal/notifications (admin-service sends it). Generate: openssl rand -hex 32
INTERNAL_API_KEY="replace-with-internal-key"
PUSH_PROVIDER=mock
# true runs the 07:00 "Chào buổi sáng" push (the only push); one instance only.
ENABLE_JOBS=false
# EXPO_ACCESS_TOKEN=
# menu-service base URL for today's family breakfast (POST /internal/breakfast-today, same INTERNAL_API_KEY).
MENU_SERVICE_URL=http://localhost:4007
