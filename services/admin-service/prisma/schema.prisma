generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client-admin"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceHealthStatus {
  UP
  DOWN
  DEGRADED
}

enum ReportCategory {
  ABUSE
  SPAM
  BUG
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model MasterIngredient {
  id              String   @id @default(uuid())
  name            String   @unique
  nameNormalized   String
  category        String
  defaultUnit     String
  shelfLifeDays   Int?
  caloriesPer100g Float?
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  allergenTags    String[]
  isActive        Boolean  @default(true)
  /// Pasted https image link (never fetched by the server).
  imageUrl        String?
  /// Credit for a Commons image (scripts/fill-catalog-images): file page URL, author and license. Null for links an
  /// admin pasted; cleared when the admin replaces the image link.
  imageSource     String?
  imageAuthor     String?
  imageLicense    String?
  /// English alias used for photo recognition prompts in Kho ("a photo of carrots"); optional.
  englishName     String?
  /// 1-100; null = no promotion. A value creates/updates the user promotion in notification-service.
  discountPercent Int?
  /// Last day of the promotion (Asia/Ho_Chi_Minh calendar day).
  promoEndDate    DateTime? @db.Date
  /// First day of the discount (Vietnam calendar day); with promoEndDate it is the promotion window.
  promoStartDate  DateTime? @db.Date
  /// Optional price in whole VND (>= 0), shown in the user market; null = no price.
  price           Int?
  /// Weight in grams of one sale unit for PACK / PIECE products (Hành lá 1 bó ≈ 100 g), so recipe grams convert to
  /// packs ("Cần mua tuần này") and back; null = unknown.
  packGrams       Int?
  /// Specific word for one PIECE / BOTTLE / CAN / BOX sale unit ("quả", "bìa"...), one of the fixed words in
  /// admin.route.ts (UNIT_WORDS); null = the unit's own word ("cái", "chai", "lon", "hộp").
  unitLabel       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nameNormalized])
  @@index([category, isActive])
  @@map("master_ingredients")
}

model RecommendationWeight {
  id          String                        @id @default(uuid())
  key         String                        @unique
  value       Float
  description String?
  updatedBy   String
  version     Int                           @default(1)
  history     RecommendationWeightHistory[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@map("recommendation_weights")
}

model RecommendationWeightHistory {
  id        String               @id @default(uuid())
  weightId  String
  oldValue  Float
  newValue  Float
  changedBy String
  changedAt DateTime             @default(now())
  weight    RecommendationWeight @relation(fields: [weightId], references: [id], onDelete: Cascade)

  @@index([weightId, changedAt])
  @@map("recommendation_weight_history")
}

model ServiceHealthLog {
  id             String             @id @default(uuid())
  serviceName    String
  status         ServiceHealthStatus
  responseTimeMs Int?
  checkedAt     DateTime           @default(now())

  @@index([serviceName, checkedAt])
  @@map("service_health_logs")
}

model AccountReport {
  id             String       @id @default(uuid())
  // reporterUserId and reportedUserId intentionally have no cross-database foreign keys.
  reporterUserId String
  reportedUserId String?
  category       ReportCategory
  description    String
  status         ReportStatus @default(OPEN)
  resolvedBy     String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reporterUserId])
  @@index([reportedUserId])
  @@map("account_reports")
}

model AuditLog {
  id          String   @id @default(uuid())
  // adminUserId intentionally has no cross-database foreign key.
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
