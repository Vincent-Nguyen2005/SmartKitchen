generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client-admin"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceHealthStatus {
  UP
  DOWN
  DEGRADED
}

enum ReportCategory {
  ABUSE
  SPAM
  BUG
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model MasterIngredient {
  id              String   @id @default(uuid())
  name            String   @unique
  nameNormalized   String
  category        String
  defaultUnit     String
  shelfLifeDays   Int?
  caloriesPer100g Float?
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  allergenTags    String[]
  isActive        Boolean  @default(true)
  /// Pasted https image link (never fetched by the server).
  imageUrl        String?
  /// Credit for a Commons image (scripts/fill-catalog-images): file page URL, author and license. Null for links an
  /// admin pasted; cleared when the admin replaces the image link.
  imageSource     String?
  imageAuthor     String?
  imageLicense    String?
  /// English alias used for photo recognition prompts in Kho ("a photo of carrots"); optional.
  englishName     String?
  /// 1-100; null = no promotion. A value creates/updates the user promotion in notification-service.
  discountPercent Int?
  /// Last day of the promotion (Asia/Ho_Chi_Minh calendar day).
  promoEndDate    DateTime? @db.Date
  /// First day of the discount (Vietnam calendar day); with promoEndDate it is the promotion window.
  promoStartDate  DateTime? @db.Date
  /// Optional price in whole VND (>= 0), shown in the user market; null = no price.
  price           Int?
  /// Weight in grams of one sale unit for PACK / PIECE products (Hành lá 1 bó ≈ 100 g), so recipe grams convert to
  /// packs ("Cần mua tuần này") and back; null = unknown.
  packGrams       Int?
  /// Typical weight in grams of ONE piece (quả / củ / cây / lát) for KILOGRAM / PACK products that recipes count in
  /// pieces (Cà chua 1 quả ≈ 100 g, Bánh tráng 1 lá ≈ 10 g), so "3 quả cà chua" converts to kg / packs ("Cần mua tuần
  /// này"); null = unknown. PIECE products use packGrams (their sale unit is one piece).
  pieceGrams      Int?
  /// Specific word for one PIECE / BOTTLE / CAN / BOX sale unit ("quả", "bìa"...), one of the fixed words in
  /// admin.route.ts (UNIT_WORDS); null = the unit's own word ("cái", "chai", "lon", "hộp").
  unitLabel       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nameNormalized])
  @@index([category, isActive])
  @@map("master_ingredients")
}

model RecommendationWeight {
  id          String                        @id @default(uuid())
  key         String                        @unique
  value       Float
  description String?
  updatedBy   String
  version     Int                           @default(1)
  history     RecommendationWeightHistory[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@map("recommendation_weights")
}

model RecommendationWeightHistory {
  id        String               @id @default(uuid())
  weightId  String
  oldValue  Float
  newValue  Float
  changedBy String
  changedAt DateTime             @default(now())
  weight    RecommendationWeight @relation(fields: [weightId], references: [id], onDelete: Cascade)

  @@index([weightId, changedAt])
  @@map("recommendation_weight_history")
}

model ServiceHealthLog {
  id             String             @id @default(uuid())
  serviceName    String
  status         ServiceHealthStatus
  responseTimeMs Int?
  checkedAt     DateTime           @default(now())

  @@index([serviceName, checkedAt])
  @@map("service_health_logs")
}

model AccountReport {
  id             String       @id @default(uuid())
  // reporterUserId and reportedUserId intentionally have no cross-database foreign keys.
  reporterUserId String
  reportedUserId String?
  category       ReportCategory
  description    String
  status         ReportStatus @default(OPEN)
  resolvedBy     String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reporterUserId])
  @@index([reportedUserId])
  @@map("account_reports")
}

model AuditLog {
  id          String   @id @default(uuid())
  // adminUserId intentionally has no cross-database foreign key.
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Quản trị › "Giảm giá tự động" settings (one row, id = 1). Every day N catalog products get a per-item discount
/// that looks exactly like an admin discount in the app (no label, no notification).
model DailyDealSettings {
  id                 Int      @id @default(1)
  enabled            Boolean  @default(true)
  dealsPerDay        Int      @default(10)
  minPercent         Int      @default(5)
  maxPercent         Int      @default(20)
  excludedProductIds String[] @default([])
  updatedBy          String?
  updatedAt          DateTime @updatedAt

  @@map("daily_deal_settings")
}

/// One automatic discount of one Vietnam day. Unique per (day, product); expires with the day.
model DailyDeal {
  id        String   @id @default(uuid())
  day       DateTime @db.Date
  productId String
  percent   Int
  /// MENU (popular in this week's menus), RANDOM, or SWAP (admin "Đổi món").
  source    String
  createdAt DateTime @default(now())

  @@unique([day, productId])
  @@index([day])
  @@map("daily_deals")
}

/// The day's selection was made (written in the same transaction, under a per-day advisory lock), so concurrent
/// first requests never select twice. rerolls counts "Chọn lại hôm nay" (a new seed each time).
model DailyDealDay {
  day       DateTime @id @db.Date
  rerolls   Int      @default(0)
  createdAt DateTime @default(now())

  @@map("daily_deal_days")
}
