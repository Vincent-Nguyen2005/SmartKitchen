PORT=4011
DATABASE_URL="postgresql://postgres:postgres@localhost:5411/admin_db?schema=public"

# Background jobs (health poller + daily retention). Enable on ONE instance only.
ENABLE_JOBS=true
HEALTH_POLL_INTERVAL_SECONDS=60
HEALTH_CHECK_TIMEOUT_MS=3000
HEALTH_DEGRADED_THRESHOLD_MS=1000
HEALTH_LOG_RETENTION_DAYS=14

# Health monitor targets (same names as the gateway). Docker compose uses service DNS names.
AUTH_SERVICE_URL=http://localhost:4001
FAMILY_SERVICE_URL=http://localhost:4002
INVENTORY_SERVICE_URL=http://localhost:4003
NUTRITION_SERVICE_URL=http://localhost:4004
MEAL_DIARY_SERVICE_URL=http://localhost:4005
RECIPE_SERVICE_URL=http://localhost:4006
MENU_SERVICE_URL=http://localhost:4007
SHOPPING_LIST_SERVICE_URL=http://localhost:4008
PAYMENT_SERVICE_URL=http://localhost:4009
NOTIFICATION_SERVICE_URL=http://localhost:4010
ADMIN_SERVICE_URL=http://localhost:4011
GATEWAY_URL=http://localhost:4000

# Account reports (#59)
REPORT_RATE_LIMIT_PER_HOUR=5
# Shared with auth/family/notification internal routes. Generate: openssl rand -hex 32
INTERNAL_API_KEY="replace-with-internal-key"
NOTIFY_TIMEOUT_MS=2000

# Catalog images uploaded by admins ("Chụp ảnh"); empty = ./uploads/admin. Docker: /data/uploads/admin (named volume).
ADMIN_UPLOAD_DIR=
# "Chụp ảnh" (Quản trị): Gemini suggestions for a new ingredient / dish from a photo. Empty key or model = feature off.
# Never commit a real key: put it only in the (git-ignored) .env.
GEMINI_API_KEY=
GEMINI_MODEL=
# Suggestions per admin and Vietnam day.
AI_SUGGEST_DAILY_LIMIT=30
