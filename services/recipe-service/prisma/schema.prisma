generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-recipe"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  ingredients        String[]
  mealTypes          String[] @default([])
  dietaryTags        String[] @default([])
  tags               String[] @default([])
  preparationMinutes Int?
  servings           Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([name])
}
