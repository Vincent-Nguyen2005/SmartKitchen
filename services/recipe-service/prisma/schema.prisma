generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-recipe"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  ingredients        String[]
  mealTypes          String[] @default([])
  dietaryTags        String[] @default([])
  tags               String[] @default([])
  preparationMinutes Int?
  servings           Int?
  /// Structured ingredients: [{ "name": string, "quantity": number | null, "unit": string | null }].
  /// Units are the Kho/Giỏ hàng codes (GRAM, KILOGRAM, MILLILITER, LITER, PIECE, PACK, BOTTLE, CAN, BOX).
  /// `ingredients` keeps the plain names for older readers (mobile Công thức, nutrition-service).
  ingredientDetails  Json?
  imageUrl           String?
  /// Per serving.
  calories           Float?
  protein            Float?
  carbs              Float?
  fat                Float?
  allergens          String[] @default([])
  contraindications  String[] @default([])
  isActive           Boolean  @default(true)
  /// Cooking steps: [{ "order": number, "instruction": string, "durationSeconds": number | null,
  /// "ingredients": [{ "name": string, "quantity": number | null, "unit": string | null }] }]. Null = no steps yet.
  steps              Json?
  /// Dish role in a Vietnamese family meal: man (món mặn), xao (món xào), canh, rau, trang_mieng (tráng miệng),
  /// sang (light breakfast dish), mot_mon (one-dish meal such as phở), do_uong (drink). Null = not classified.
  role               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([name])
}
