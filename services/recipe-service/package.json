{
  "name": "recipe-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test dist/__tests__/recipe.service.test.js dist/__tests__/recipe.routes.test.js dist/__tests__/recipe.steps.test.js dist/__tests__/recipe.seasonings.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "prisma": "5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/cors": "^2.8.17",
    "ts-node": "10.9.2"
  },
  "prisma": {
    "seed": "ts-node --skip-project prisma/seed.ts"
  }
}
