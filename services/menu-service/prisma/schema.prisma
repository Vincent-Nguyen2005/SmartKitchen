generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-menu"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PeriodType {
  DAY
  WEEK
  MONTH
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// A family's menu is shared by all its members (familyId set); users without a family keep personal menus
/// (familyId null, read by userId). One active (archived = false) menu per family, day and period: enforced by the
/// partial unique index "Menu_family_period_active_key" created in SQL (migration 20261125000000_family_menus), since
/// Prisma cannot declare a partial index.
model Menu {
  id         String     @id @default(uuid())
  /// Member who generated it (creator); a family menu is read through familyId.
  userId     String
  /// Owning family (its Kho is used and it scopes "dish repeated in the last 3 days").
  familyId   String?
  /// People the menu is cooked for: the family's member count when generated (1 for personal menus, null before).
  servings   Int?
  /// An older duplicate kept readable as history after the family backfill (never deleted, never listed).
  archived   Boolean    @default(false)
  /// Generated without any family health data (no allergies known yet): the app shows a small notice on Lịch.
  healthUnavailable Boolean @default(false)
  /// sha256 of the Kho snapshot the suggestions used (same hash as AI suggestions). A different current hash
  /// means today's menu is stale and the app regenerates it.
  khoHash    String?
  title      String
  periodType PeriodType @default(WEEK)
  startDate  DateTime
  endDate    DateTime
  items      MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@index([familyId, startDate])
}

model MenuItem {
  id        String   @id @default(uuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  recipeId  String?
  dishName  String
  mealType  MealType @default(LUNCH)
  dayOfWeek Int
  calories  Float?
  /// Kho suggestion: { imageUrl, availableIngredients: string[], missingIngredients: [{ name, quantity, unit }],
  /// availableCount, totalCount, reason }. Null for manual items.
  details   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}

/// Latest AI dish suggestions per family ("Món gợi ý từ Kho"), generated from a Kho snapshot.
model AiSuggestion {
  familyId        String   @id
  /// Validated dishes: [{ id, name, description, servings, totalMinutes, ingredients[], steps[] }].
  dishes          Json
  /// sha256 of the Kho snapshot the dishes were made from; the same hash never calls the model again.
  khoHash         String
  /// ready | error (the last call failed; `dishes` still holds the previous result).
  status          String   @default("ready")
  errorMessage    String?
  generatedAt     DateTime @default(now())
  /// Daily limit bookkeeping (Vietnam day YYYY-MM-DD).
  generationDay   String
  generationCount Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/// A dish a family saved to cook again (source "ai" for AI suggestions). Family-only.
model SavedRecipe {
  id        String   @id @default(uuid())
  familyId  String
  source    String   @default("ai")
  name      String
  /// The dish as suggested (ingredients and steps).
  dish      Json
  createdBy String
  createdAt DateTime @default(now())

  @@unique([familyId, name])
  @@index([familyId])
}

/// "Số món mỗi bữa" for users without a family (and the source the family settings were seeded from).
model MenuSettings {
  userId    String   @id
  breakfast Int      @default(3)
  lunch     Int      @default(5)
  dinner    Int      @default(5)
  updatedAt DateTime @updatedAt
}

/// "Số món mỗi bữa" of a family (1-6 each); everyone reads it, only the family OWNER changes it.
model FamilyMenuSettings {
  familyId  String   @id
  breakfast Int      @default(3)
  lunch     Int      @default(5)
  dinner    Int      @default(5)
  updatedAt DateTime @updatedAt
}

/// Dishes removed from a menu (dislike history): not suggested again for 7 days. Per family when familyId is set
/// (all members' removals count), else per user.
model RemovedDish {
  id        String   @id @default(uuid())
  userId    String
  familyId  String?
  recipeId  String?
  dishName  String
  removedAt DateTime @default(now())

  @@index([userId, removedAt])
  @@index([familyId, removedAt])
}

/// Last successfully loaded family health context (members' allergies, conditions, meal targets), per family
/// ("family:<id>") or personal user ("user:<id>"). Used when family-service / nutrition-service cannot be reached,
/// so a menu never falls back to "no allergies" once the family's data has been seen.
model FamilyHealthContext {
  key       String   @id
  /// [{ userId, name, allergies[], conditions[], mealTargets: { breakfast, lunch, dinner } }]
  members   Json
  updatedAt DateTime @updatedAt
}
