generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-menu"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PeriodType {
  DAY
  WEEK
  MONTH
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Menu {
  id         String     @id @default(uuid())
  userId     String
  /// Family whose Kho the suggestions used (also scopes "dish repeated in the last 3 days").
  familyId   String?
  title      String
  periodType PeriodType @default(WEEK)
  startDate  DateTime
  endDate    DateTime
  items      MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@index([familyId, startDate])
}

model MenuItem {
  id        String   @id @default(uuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  recipeId  String?
  dishName  String
  mealType  MealType @default(LUNCH)
  dayOfWeek Int
  calories  Float?
  /// Kho suggestion: { imageUrl, availableIngredients: string[], missingIngredients: [{ name, quantity, unit }],
  /// availableCount, totalCount, reason }. Null for manual items.
  details   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}
