generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PeriodType {
  DAY
  WEEK
  MONTH
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Menu {
  id         String     @id @default(uuid())
  userId     String
  title      String
  periodType PeriodType @default(WEEK)
  startDate  DateTime
  endDate    DateTime
  items      MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model MenuItem {
  id        String   @id @default(uuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  recipeId  String?
  dishName  String
  mealType  MealType @default(LUNCH)
  dayOfWeek Int
  calories  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}
