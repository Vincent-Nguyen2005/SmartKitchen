# Root environment for `docker compose` (read automatically from ./.env).
# Copy this file to .env and fill in the values BEFORE `docker compose up`:
#   cp .env.example .env            (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored. Never commit real secrets.

# --- Required (compose refuses to start without it: ${JWT_SECRET:?...}) ---
# Shared by auth-service (signs access tokens), family-service and the gateway (verifies them, HS256).
# auth-service and family-service refuse to start in production with fewer than 32 characters.
# Generate (64 hex chars):  openssl rand -hex 32
#   PowerShell: -join (1..64 | % { [char]((48..57)+(97..102) | Get-Random) })
#   (Do not use `Get-Random -Count 64` on the 16 hex digits: it samples without replacement and yields only 16 chars.)
JWT_SECRET=replace-with-a-64-char-random-hex-string

# --- Service-to-service keys ---
# Required: shared by admin -> auth/family/notification and family -> auth on /internal/*.
# Generate a separate 64-character key: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-a-random-internal-key
# Purchase-sync key is required by compose and shared only by shopping-list-service and inventory-service.
PURCHASE_SYNC_API_KEY=replace-with-a-random-purchase-sync-key

# --- Optional payment provider sandbox configuration ---
# Set PAYMENT_PUBLIC_BASE_URL to the API gateway URL reachable by VNPAY/MoMo and the device.
PAYMENT_PUBLIC_BASE_URL=http://localhost:4000
PAYMENT_APP_RETURN_URL=smartkitchen://payment-result
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create

# --- Optional Sprint 3 inventory capture tuning ---
OPENFOODFACTS_USER_AGENT=SmartKitchen/1.0 (contact@example.com)
TESSERACT_LANGUAGES=vie+eng
# TESSERACT_LANG_PATH=https://tessdata.projectnaptha.com/4.0.0

# --- auth-service email OTP (optional locally; without SMTP_USER/SMTP_PASS no OTP emails are sent) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional one-time admin seed; set both only on the shared host. Never commit credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: defaults to SmartKitchen App <SMTP_USER> so the sender matches the SMTP account.
EMAIL_FROM=
# Optional with docker-compose.smtp-ca.example.yml when a trusted local antivirus/proxy intercepts SMTP TLS.
# Point to a PEM-encoded CA certificate trusted by the host; keep the file outside Git.
# SMTP_CA_CERT_PATH=D:/path/to/trusted-smtp-ca.pem
CORS_ORIGIN=

# --- Optional tuning (compose defaults shown) ---
# Admin health monitor poll interval; use e.g. 10 for local testing.
HEALTH_POLL_INTERVAL_SECONDS=60
# Account reports a single user may file per rolling hour.
REPORT_RATE_LIMIT_PER_HOUR=5
